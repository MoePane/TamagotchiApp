<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dog_wallpaper2"
    android:scaleType="fitCenter"
    tools:context=".MainActivity2">


    <Button
        android:id="@+id/btnFe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:text="Feed"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/sbHap"
        app:layout_constraintEnd_toStartOf="@+id/btnCle"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnPla"
        app:layout_constraintTop_toBottomOf="@+id/ivKing2"
        app:layout_constraintVertical_bias="0.5" />

    <SeekBar
        android:id="@+id/sbHap"
        android:layout_width="380dp"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:background="@color/white"
        android:max="100"
        android:progress="30"
        app:layout_constraintBottom_toTopOf="@+id/tvHap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.483"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnFe"
        app:layout_constraintVertical_bias="0.5" />

    <SeekBar
        android:id="@+id/sbHun"
        android:layout_width="380dp"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:background="@color/white"
        android:max="100"
        android:progress="30"
        app:layout_constraintBottom_toTopOf="@+id/tvHung"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHap"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/btnPla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:text="Play"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/sbHap"
        app:layout_constraintEnd_toStartOf="@+id/btnFe"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivKing2"
        app:layout_constraintVertical_bias="0.5" />

    <Button
        android:id="@+id/btnCle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:text="Clean"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/sbHap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnFe"
        app:layout_constraintTop_toBottomOf="@+id/ivKing2"
        app:layout_constraintVertical_bias="0.5" />

    <SeekBar
        android:id="@+id/sbCle"
        android:layout_width="380dp"
        android:layout_height="50dp"
        android:layout_centerHorizontal="true"
        android:background="@color/white"
        android:max="100"
        android:progress="30"
        app:layout_constraintBottom_toTopOf="@+id/tvClean"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHung"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/tvHap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fontFamily="@font/aclonica"
        android:text="Happiness"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/sbHun"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbHap"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/tvHung"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fontFamily="@font/aclonica"
        android:text="Hunger"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/sbCle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbHun"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/tvClean"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fontFamily="@font/aclonica"
        android:text="Cleanliness"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbCle"
        app:layout_constraintVertical_bias="0.5" />

    <ImageView
        android:id="@+id/ivKing2"
        android:layout_width="314dp"
        android:layout_height="355dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPla"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/oip" />

</androidx.constraintlayout.widget.ConstraintLayout>